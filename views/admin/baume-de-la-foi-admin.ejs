        function loadAdminComments() {
            fetch('/admin/api/reflexion/commentaires?t=' + Date.now())
                .then(r => r.json().then(data => ({ ok: r.ok, data })))
                .then(({ ok, data }) => {
                    if (!ok || !data.success) throw new Error(data.error || 'Erreur de chargement');
                    adminComments = data.data;
                    renderAdminComments();
                })
                .catch(err => showNotification('Commentaires : ' + err.message, 'error'));
        }

        function setCommentsFilter(filter, btn) {
            adminCommentsFilter = filter;
            document.querySelectorAll('#comments-filters .btn').forEach(b => b.classList.toggle('active', b === btn));
            renderAdminComments();
        }

        function renderAdminComments() {
            const pending = adminComments.filter(c => !c.is_approved).length;
            const badge = document.getElementById('pendingCommentsBadge');
            badge.textContent = pending;
            badge.style.display = pending ? 'inline' : 'none';
            document.getElementById('commentsTotal').textContent = adminComments.length;
            document.getElementById('commentsPending').textContent = pending;
            document.getElementById('commentsApproved').textContent = adminComments.length - pending;

            const rows = adminComments.filter(c =>
                adminCommentsFilter === 'all' ||
                (adminCommentsFilter === 'pending' ? !c.is_approved : !!c.is_approved));
            const tbody = document.querySelector('#comments-table tbody');
            tbody.innerHTML = '';
            if (!rows.length) {
                tbody.innerHTML = '<tr><td colspan="5" class="text-center"><div class="empty-state"><i class="fas fa-comments"></i><h4>Aucun commentaire</h4><p>Rien à afficher pour ce filtre.</p></div></td></tr>';
                return;
            }
            rows.forEach(c => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td style="white-space:nowrap;"></td>
                    <td><strong></strong></td>
                    <td style="max-width:360px;"><div class="cmt-text" style="white-space:pre-wrap;"></div></td>
                    <td style="max-width:240px;"><small class="text-muted"></small></td>
                    <td style="white-space:nowrap;"></td>`;
                const cells = tr.children;
                cells[0].textContent = new Date(c.created_at.replace(' ', 'T') + 'Z').toLocaleString('fr-FR', { dateStyle: 'short', timeStyle: 'short' });
                cells[1].querySelector('strong').textContent = c.author_name;
                cells[2].querySelector('.cmt-text').textContent = c.content;
                const pdv = c.pdv_content ? (c.pdv_author || 'Anonyme') + ' : « ' + c.pdv_content.slice(0, 80) + (c.pdv_content.length > 80 ? '…' : '') + ' »' : 'Point de vue supprimé';
                cells[3].querySelector('small').textContent = pdv;

                const actions = cells[4];
                const toggleBtn = document.createElement('button');
                toggleBtn.className = 'btn btn-sm ' + (c.is_approved ? 'btn-outline-secondary' : 'btn-success');
                toggleBtn.innerHTML = c.is_approved ? '<i class="fas fa-eye-slash"></i> Masquer' : '<i class="fas fa-check"></i> Publier';
                toggleBtn.onclick = () => moderateComment(c.id, !c.is_approved);
                const delBtn = document.createElement('button');
                delBtn.className = 'btn btn-sm btn-outline-danger ms-1';
                delBtn.innerHTML = '<i class="fas fa-trash"></i> Supprimer';
                delBtn.onclick = async () => {
                    if (await adminConfirm('Supprimer ce commentaire ?', 'Il sera supprimé définitivement.', { confirmText: 'Supprimer', danger: true })) deleteComment(c.id);
                };
                actions.append(toggleBtn, delBtn);
                tbody.appendChild(tr);
            });
        }

        function moderateComment(id, approved) {
            fetch('/admin/api/reflexion/commentaires/' + id + '/approve', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ approved })
            })
                .then(r => r.json())
                .then(result => {
                    if (!result.success) throw new Error(result.error || 'Erreur');
                    showNotification(result.message, approved ? 'success' : 'info');
                    loadAdminComments();
                })
                .catch(err => showNotification('Erreur : ' + err.message, 'error'));
        }

        function deleteComment(id) {
            fetch('/admin/api/reflexion/commentaires/' + id, { method: 'DELETE' })
                .then(r => r.json())
                .then(result => {
                    if (!result.success) throw new Error(result.error || 'Erreur');
                    showNotification(result.message, 'success');
                    loadAdminComments();
                })
                .catch(err => showNotification('Erreur : ' + err.message, 'error'));
        }

        document.addEventListener('DOMContentLoaded', loadAdminComments);

        // ===== SONDAGE OPINION PUBLIQUE =====
        let pollAdminData = null;

        function loadPollAdmin() {
            fetch('/admin/api/opinion/results?t=' + Date.now())
                .then(r => r.json().then(data => ({ ok: r.ok, data })))
                .then(({ ok, data }) => {
                    if (!ok || !data.success) throw new Error(data.error || 'Erreur de chargement');
                    pollAdminData = data;
                    const fmt = n => Number(n || 0).toLocaleString('fr-FR');
                    document.getElementById('pollStatVotes').textContent = fmt(data.stats.votes);
                    document.getElementById('pollStatParticipants').textContent = fmt(data.stats.participants);
                    document.getElementById('pollStatLast7').textContent = fmt(data.stats.last7);
                    document.getElementById('pollStatAnswered').textContent = data.stats.answered + ' / ' + data.stats.questions;
                    const themeSelect = document.getElementById('pollThemeFilter');
                    if (themeSelect.options.length === 1) {
                        [...new Set(data.questions.map(q => q.theme))].forEach(th => themeSelect.add(new Option(th, th)));
                    }
                    const today = document.getElementById('pollToday');
                    today.innerHTML = '';
                    data.questions.filter(q => q.today).forEach(q => today.appendChild(pollAdminCard(q)));
                    renderPollAdmin();
                })
                .catch(err => showNotification('Sondage : ' + err.message, 'error'));
        }

        function pollAdminCard(q) {
            const card = document.createElement('article');
            card.className = 'poll-admin-card';
            card.innerHTML = '<div class="poll-admin-card-head"><span class="poll-admin-theme"></span><span class="poll-admin-total"></span></div><h4></h4><ul class="poll-admin-bars"></ul>';
            card.querySelector('.poll-admin-theme').textContent = q.theme;
            card.querySelector('.poll-admin-total').textContent = q.total + (q.total > 1 ? ' votes' : ' vote');
            card.querySelector('h4').textContent = q.question;
            const max = Math.max(...q.counts);
            const list = card.querySelector('.poll-admin-bars');
            q.options.forEach((label, i) => {
                const pct = q.total ? Math.round(q.counts[i] / q.total * 100) : 0;
                const li = document.createElement('li');
                li.className = q.total && q.counts[i] === max ? 'is-top' : '';
                li.innerHTML = '<div class="poll-admin-bar-label"><span></span><strong></strong></div><div class="poll-admin-bar"><span></span></div>';
                li.querySelector('.poll-admin-bar-label span').textContent = label;
                li.querySelector('.poll-admin-bar-label strong').textContent = pct + ' % (' + q.counts[i] + ')';
                li.querySelector('.poll-admin-bar span').style.width = pct + '%';
                list.appendChild(li);
            });
            return card;
        }

        function renderPollAdmin() {
            if (!pollAdminData) return;
            const theme = document.getElementById('pollThemeFilter').value;
            const sort = document.getElementById('pollSort').value;
            const onlyAnswered = document.getElementById('pollOnlyAnswered').checked;
            const search = document.getElementById('pollSearch').value.trim().toLowerCase();
            let list = pollAdminData.questions.filter(q =>
                (!theme || q.theme === theme) &&
                (!onlyAnswered || q.total > 0) &&
                (!search || q.question.toLowerCase().includes(search)));
            list = list.slice().sort((a, b) => sort === 'votes' ? (b.total - a.total || a.order - b.order) : a.order - b.order);
            const box = document.getElementById('pollAll');
            box.innerHTML = '';
            if (!list.length) {
                box.innerHTML = '<div class="empty-state"><i class="fas fa-poll"></i><h4>Aucune question</h4><p>' +
                    (onlyAnswered ? 'Aucune question n\'a encore reçu de vote pour ce filtre.' : 'Aucune question ne correspond à ce filtre.') + '</p></div>';
                return;
            }
            list.forEach(q => box.appendChild(pollAdminCard(q)));
        }

        function exportPollCsv() {
            if (!pollAdminData) return;
            const cell = v => '"' + String(v).replace(/"/g, '""') + '"';
            const lines = [['Thème', 'Question', 'Réponse', 'Votes', 'Pourcentage', 'Total question'].map(cell).join(';')];
            pollAdminData.questions.forEach(q => q.options.forEach((opt, i) => {
                const pct = q.total ? Math.round(q.counts[i] / q.total * 100) : 0;
                lines.push([q.theme, q.question, opt, q.counts[i], pct + ' %', q.total].map(cell).join(';'));
            }));
            const blob = new Blob(['\ufeff' + lines.join('\r\n')], { type: 'text/csv;charset=utf-8' });
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = 'sondage-opinion-publique-' + new Date().toISOString().slice(0, 10) + '.csv';
            document.body.appendChild(a);
            a.click();
            setTimeout(() => { URL.revokeObjectURL(a.href); a.remove(); }, 1000);
        }

        // ===== RAFRAÎCHISSEMENT DES DONNÉES =====
        function refreshDashboardData() {
            window.location.reload();
        }

        function exportData() {
            showNotification('Fonction d\'export à implémenter', 'info');
        }

        // ===== NOTIFICATIONS =====
        function showNotification(message, type) {
            var notification = document.createElement('div');
            notification.className = 'notification-toast ' + type;
            
            var icons = {
                success: 'check-circle',
                error: 'exclamation-circle',
                warning: 'exclamation-triangle',
                info: 'info-circle'
            };
            
            var iconClass = icons[type] || 'info-circle';
            
            notification.innerHTML = 
                '<i class="fas fa-' + iconClass + '"></i>' +
                '<span style="flex: 1;">' + message + '</span>' +
                '<button onclick="this.parentElement.remove()" style="background: none; border: none; color: var(--text-lighter); cursor: pointer;">' +
                    '<i class="fas fa-times"></i>' +
                '</button>';
            
            document.body.appendChild(notification);
            setTimeout(function() {
                if (notification.parentElement) {
                    notification.remove();
                }
            }, 5000);
        }

        // ===== GESTIONNAIRES DE FORMULAIRES =====
        async function handlePriereSubmit(e) {
            e.preventDefault();
            
            const form = e.target;
            const formData = new FormData(form);
            const idField = document.getElementById('priereId');
            const isUpdate = idField && idField.value && idField.value !== '';
            
            const submitBtn = document.getElementById('submitPriereBtn');
            const originalText = submitBtn.innerHTML;
            
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Enregistrement...';
            submitBtn.disabled = true;
            
            try {
                const url = isUpdate ? form.action : '/api/baume/prieres';
                
                const response = await fetch(url, {
                    method: isUpdate ? 'PUT' : 'POST',
                    body: formData
                });
                
                const result = await response.json();
                
                if (result.success) {
                    showNotification(result.message || 'Succès', 'success');
                    
                    if (!isUpdate) {
                        resetPriereForm();
                    }
                    
                    setTimeout(() => refreshDashboardData(), 1500);
                } else {
                    showNotification(result.error || 'Erreur', 'error');
                }
            } catch (error) {
                showNotification('Erreur: ' + error.message, 'error');
            } finally {
                submitBtn.innerHTML = originalText;
                submitBtn.disabled = false;
            }
        }

