            console.log('🔍 Search results:', filtered.length, 'testimonials');
            displayTemoignages(filtered, false);
        }

        // ===== Fenêtre de dialogue (confirmation / lecture) =====
        function openRxDialog({ title, icon, danger, body, buttons }) {
            const backdrop = document.getElementById('rxDialog');
            const box = backdrop.querySelector('.rx-dialog');
            box.classList.toggle('is-danger', !!danger);
            backdrop.querySelector('.rx-dialog-icon i').className = 'fas fa-' + (icon || 'question');
            document.getElementById('rxDialogTitle').textContent = title;
            const bodyEl = document.getElementById('rxDialogBody');
            bodyEl.innerHTML = '';
            bodyEl.appendChild(body);
            const foot = document.getElementById('rxDialogFoot');
            foot.innerHTML = '';
            return new Promise(resolve => {
                const close = value => {
                    backdrop.hidden = true;
                    document.removeEventListener('keydown', onKey);
                    resolve(value);
                };
                const onKey = e => { if (e.key === 'Escape') close(false); };
                buttons.forEach(btnDef => {
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'rx-dialog-btn' + (btnDef.variant ? ' ' + btnDef.variant : '');
                    btn.textContent = btnDef.label;
                    btn.addEventListener('click', () => close(btnDef.value));
                    foot.appendChild(btn);
                });
                backdrop.onclick = e => { if (e.target === backdrop) close(false); };
                document.addEventListener('keydown', onKey);
                backdrop.hidden = false;
                foot.lastElementChild.focus();
            });
        }

        function adminConfirm(title, message, { confirmText = 'Confirmer', danger = false } = {}) {
            const p = document.createElement('p');
            p.textContent = message;
            return openRxDialog({
                title, danger, icon: danger ? 'trash' : 'question', body: p,
                buttons: [
                    { label: 'Annuler', value: false },
                    { label: confirmText, value: true, variant: danger ? 'danger' : 'primary' }
                ]
            });
        }

        function escapeHtml(value) {
            return String(value == null ? '' : value).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        }

        function getStatusBadge(status) {
            const badges = {
                'approved': '<span class="badge badge-success"><i class="fas fa-check-circle me-1"></i>Approuvé</span>',
                'pending': '<span class="badge badge-warning"><i class="fas fa-clock me-1"></i>En attente</span>',
                'rejected': '<span class="badge badge-secondary"><i class="fas fa-times-circle me-1"></i>Rejeté</span>'
            };
            return badges[status] || '<span class="badge badge-secondary">Inconnu</span>';
        }

        function updateTemoignagesStats(temoignages) {
            const total = temoignages.length;
            const approved = temoignages.filter(t => t.status === 'approved').length;
            const pending = temoignages.filter(t => t.status === 'pending').length;
            const rejected = temoignages.filter(t => t.status === 'rejected').length;
            
            document.getElementById('totalTemoignages').textContent = total;
            document.getElementById('approvedTemoignages').textContent = approved;
            document.getElementById('pendingTemoignages').textContent = pending;
            document.getElementById('rejectedTemoignages').textContent = rejected;
        }

        function showTemoignageDetail(t) {
            const wrap = document.createElement('div');
            const meta = document.createElement('div');
            meta.className = 'rx-dialog-meta';
            const add = (icon, text, href) => {
                const span = document.createElement(href ? 'a' : 'span');
                if (href) span.href = href;
                span.innerHTML = '<i class="fas fa-' + icon + ' me-1"></i>';
                span.appendChild(document.createTextNode(text));
                meta.appendChild(span);
            };
            if (t.ville) add('map-marker-alt', t.ville);
            if (t.created_at) add('calendar', new Date(String(t.created_at).replace(' ', 'T') + 'Z').toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }));
            if (t.author_email) add('envelope', t.author_email, 'mailto:' + t.author_email);
            const text = document.createElement('p');
            text.className = 'rx-dialog-text';
            text.textContent = t.content || 'Aucun contenu';
            wrap.append(meta, text);
            const buttons = [{ label: 'Fermer', value: null }];
            if (t.status === 'pending') {
                buttons.unshift({ label: 'Rejeter', value: 'reject' });
                buttons.push({ label: 'Publier', value: 'approve', variant: 'primary' });
            }
            openRxDialog({ title: 'Point de vue de ' + (t.author_name || 'Anonyme'), icon: 'comment-dots', body: wrap, buttons })
                .then(choice => {
                    if (choice === 'approve') approveTemoignage(t.id);
                    if (choice === 'reject') rejectTemoignage(t.id);
                });
        }

