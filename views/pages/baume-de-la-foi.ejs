<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Réflexion | Telex</title>
    <link rel="icon" href="/images/Telex.png" type="image/png">
    
    <!-- Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Montserrat:wght@400;500;600;700&family=Open+Sans:wght@400;500;600&family=League+Spartan:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- CSS Principal de Telex -->
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/baume-navbar.css">

    <style>
        :root {
            --baume-primary: #2E5C4E;
            --baume-accent: #3AAFA9;
            --baume-gradient: linear-gradient(135deg, #2E5C4E, #3AAFA9);
        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <%- include('../partials/navbar') %>

    
    
    <!-- ===== IMAGES FLOTTANTES DÉPLACEMENT LENT ===== -->
    <div class="floating-images-container" style="position: fixed; top: 400px; left: 0; width: 100%; height: calc(100vh - 400px - 200px); pointer-events: none; z-index: 1;">
        <!-- Ligne verticale gauche -->
        <div style="position: absolute; top: 0; left: 0; width: 10px; height: 100%; background: #EAE3D6; z-index: -1;"></div>
        
        <!-- Ligne verticale droite -->
        <div style="position: absolute; top: 0; right: 0; width: 10px; height: 100%; background: #EAE3D6; z-index: -1;"></div>
    </div>

    <!-- ===== PRÉSENTATION RÉFLEXION ===== -->
    <section class="rx-banner rx-banner--hero">
        <div class="rx-banner-icon" aria-hidden="true"><i class="fas fa-lightbulb"></i></div>
        <div class="rx-banner-body">
            <div class="rx-tag"><span class="rx-tag-main">Réflexion</span><span class="rx-tag-sub">par Telex Madagascar</span></div>
            <h1 class="rx-hero-title">Penser, comprendre, s'exprimer.</h1>
            <p class="rx-banner-text">
                Une réflexion est un processus de pensée et d'analyse qui permet de mieux comprendre une idée,
                une situation ou un enseignement, afin d'en tirer un sens et une application dans la vie quotidienne.
            </p>
        </div>
    </section>

    <!-- ===== NAVIGATION CATÉGORIES ===== -->
    <section style="background: white; border-bottom: 1px solid #f0f0f0; position: sticky; top: 70px; z-index: 100; width: 100%; max-width: 100vw; overflow: hidden;">
        <div class="container-fluid" style="padding: 0 12px;">
            <nav class="baume-category-nav">
                <a href="#prieres" class="baume-cat-btn active" onclick="setActiveNav(this)">
                    <i class="fas fa-sun"></i> Inspirations
                </a>
                <a href="#reflexions" class="baume-cat-btn" onclick="setActiveNav(this)">
                    <i class="fas fa-search"></i> Analyses
                </a>
                <a href="#temoignage-form" class="baume-cat-btn" onclick="setActiveNav(this)">
                    <i class="fas fa-comment-dots"></i> Points de vue
                </a>
            </nav>
        </div>
    </section>

    <!-- ===== PRIÈRES PUBLIÉES ===== -->
    <section id="prieres" style="background: #ffffff; padding: 3rem 0;">
        <div class="container-fluid" style="max-width: 100%; padding: 0 3rem;">

            <!-- Bannière inspirations -->
            <div class="rx-banner rx-banner--inspiration mb-4">
                <div class="rx-banner-icon" aria-hidden="true"><i class="fas fa-sun"></i></div>
                <div class="rx-banner-body">
                    <div class="rx-tag"><span class="rx-tag-main">Inspiration</span><span class="rx-tag-sub">du jour</span></div>
                    <p class="rx-banner-text">
                        Une pensée, une prière, une parole pour accompagner votre journée.
                        Prendre un moment pour soi aide à retrouver le calme, la confiance et l'élan pour avancer.
                    </p>
                    <p class="rx-banner-quote">« Ne vous inquiétez de rien ; la paix gardera vos cœurs et vos pensées. » <strong>Philippiens 4:6-7</strong></p>
                </div>
            </div>

            <!-- Section header style TopChrétien -->
            <div class="baume-section-header">
                <div class="baume-section-title-wrap">
                    <div class="baume-section-accent"></div>
                    <span class="baume-section-label"><i class="fas fa-dove me-1"></i> Au quotidien</span>
                    <h2 class="baume-section-title">Inspirations</h2>
                    <span class="baume-section-subtitle">Des pensées et des prières pour vivre chaque moment de votre journée</span>
                </div>
            </div>

            <!-- ===== CARROUSEL DE PRIÈRES ===== -->
            <div class="prieres-carousel-container position-relative mx-auto" style="max-width: 100%;">
                <!-- Boutons de navigation -->
                <button class="carousel-nav-btn carousel-prev-prieres" onclick="changePriereSlide(-1)" style="position: absolute; left: 20px; top: 50%; transform: translateY(-50%); z-index: 10; background: var(--baume-primary); color: white; border: none; border-radius: 50%; width: 50px; height: 50px; display: flex; align-items: center; justify-content: center; cursor: pointer; box-shadow: 0 4px 15px rgba(0,0,0,0.2); transition: all 0.3s ease;">
                    <i class="fas fa-chevron-left"></i>
                </button>
                <button class="carousel-nav-btn carousel-next-prieres" onclick="changePriereSlide(1)" style="position: absolute; right: 20px; top: 50%; transform: translateY(-50%); z-index: 10; background: var(--baume-primary); color: white; border: none; border-radius: 50%; width: 50px; height: 50px; display: flex; align-items: center; justify-content: center; cursor: pointer; box-shadow: 0 4px 15px rgba(0,0,0,0.2); transition: all 0.3s ease;">
                    <i class="fas fa-chevron-right"></i>
                </button>

                <!-- Conteneur du carrousel -->
                <div class="carousel-wrapper" style="overflow: hidden; border-radius: 16px; width: 100%;">
                    <div id="prieresCarousel" class="carousel-track" style="display: flex; transition: transform 0.5s ease;">
                        <% if (prieres && prieres.length > 0) { %>
                            <% // Grouper les prières par 3 pour l'affichage horizontal en pleine largeur %>
                            <% for (let i = 0; i < prieres.length; i += 3) { %>
                                <div class="carousel-slide" style="min-width: 100%; padding: 0;">
                                    <div class="row g-0 h-100">
                                        <% for (let j = i; j < Math.min(i + 3, prieres.length); j++) { %>
                                            <% if (prieres[j]) { %>
                                                <% const priere = prieres[j]; %>
                                                <% const mediaUrl = priere.image_url || priere.video_url; %>
                                                <% const isVideo = (priere.media_type === 'video' || (priere.video_url && priere.video_url.match(/\.(mp4|webm|ogg|mov)$/i))) && !priere.image_url; %>
                                                <div class="col-4">
                                                    <div class="content-card" onclick="openPriereModal(<%= j %>)" style="height: 280px; width: 100%;">
                                                        
                                                        <!-- Affichage du média en pleine largeur -->
                                                        <% if (priere.video_url || priere.image_url) { %>
                                                        <div class="media-card" style="width: 100%; height: 100%;">
                                                            <% if (isVideo) { %>
                                                                <video muted loop playsinline preload="metadata" style="width: 100%; height: 100%; object-fit: cover;">
                                                                    <source src="<%= mediaUrl %>" type="video/mp4">
                                                                </video>
                                                            <% } else { %>
                                                                <img src="<%= mediaUrl %>" alt="<%= priere.title %>" loading="lazy" style="width: 100%; height: 100%; object-fit: cover;">
                                                            <% } %>
                                                            
                                                            <!-- Badge média -->
                                                            <span class="media-badge">
                                                                <i class="fas fa-<%= isVideo ? 'video' : 'image' %>"></i>
                                                                <%= isVideo ? 'Vidéo' : 'Image' %>
                                                            </span>
                                                            
                                                            <!-- Badge référence biblique -->
                                                            <% if (priere.reference_biblique) { %>
                                                            <span class="reference-badge">
                                                                <i class="fas fa-bible"></i>
                                                                <%= priere.reference_biblique %>
                                                            </span>
                                                            <% } %>
                                                            
                                                            <!-- Titre en bas de l'image -->
                                                            <div class="card-title-overlay">
                                                                <h3>
                                                                    <i class="fas fa-dove"></i>
                                                                    <%= priere.title %>
                                                                </h3>
                                                            </div>
                                                        </div>
                                                        <% } else { %>
                                                        <!-- Si pas de média, afficher seulement le titre avec fond vert -->
                                                        <div class="media-card no-media">
                                                            <div class="card-title-overlay" style="position: relative; background: linear-gradient(to top, rgba(46,92,78,0.7) 0%, rgba(46,92,78,0.3) 100%);">
                                                                <h3>
                                                                    <i class="fas fa-dove"></i>
                                                                    <%= priere.title %>
                                                                </h3>
                                                            </div>
                                                            
                                                            <!-- Badge référence biblique -->
                                                            <% if (priere.reference_biblique) { %>
                                                            <span class="reference-badge">
                                                                <i class="fas fa-bible"></i>
                                                                <%= priere.reference_biblique %>
                                                            </span>
                                                            <% } %>
                                                        </div>
                                                        <% } %>
                                                        
                                                        <!-- Contenu caché (sera affiché dans la modale) -->
                                                        <div class="card-body-hidden">
                                                            <div class="hidden-content"><%= priere.content || '' %></div>
                                                            <% if (priere.reference_biblique) { %>
                                                            <div class="hidden-reference"><%= priere.reference_biblique %></div>
                                                            <% } %>
                                                            <div class="hidden-author"><%= priere.author || 'Baume de la Foi' %></div>
                                                        </div>
                                                    </div>
                                                </div>
                                            <% } %>
                                        <% } %>
                                    </div>
                                </div>
                            <% } %>
                        <% } else { %>
                            <div class="carousel-slide" style="min-width: 100%; padding: 0;">
                                <div class="empty-state">
                                    <i class="fas fa-pray"></i>
                                    <h4>Aucune inspiration pour le moment</h4>
                                    <p>Revenez plus tard pour découvrir de nouvelles inspirations</p>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

    <!-- ===== OPINION PUBLIQUE ===== -->
    <% const pollQs = (typeof opinionQuestions !== 'undefined' && opinionQuestions) ? opinionQuestions : []; %>
    <% if (pollQs.length) { %>
    <section id="quiz-section" style="background: #f0f4f8; padding: 3rem 0;">
        <div class="container">

            <!-- Section header -->
            <div class="baume-section-header">
                <div class="baume-section-title-wrap">
                    <div class="baume-section-accent"></div>
                    <span class="baume-section-label"><i class="fas fa-bullhorn me-1"></i> Votre avis</span>
                    <h2 class="baume-section-title">Opinion Publique</h2>
                    <span class="baume-section-subtitle">Donnez votre avis et découvrez ce que pensent les autres participants</span>
                </div>
            </div>

            <!-- Bannière opinion -->
            <div class="rx-banner rx-banner--opinion mb-4">
                <div class="rx-banner-icon" aria-hidden="true"><i class="fas fa-bullhorn"></i></div>
                <div class="rx-banner-body">
                    <div class="rx-tag"><span class="rx-tag-main">Votre avis</span><span class="rx-tag-sub">compte</span></div>
                    <p class="rx-banner-text">
                        Chaque jour, cinq questions sur la société, l'éducation, l'environnement, l'emploi ou la vie citoyenne.
                        Votez en un clic et comparez votre avis à celui des autres participants.
                    </p>
                </div>
            </div>

            <!-- Carte sondage -->
            <div class="quiz-card">

                <div class="quiz-top-bar">
                    <div class="quiz-question-badge">
                        <i class="fas fa-poll"></i>
                        Question <span id="currentQuestion">1</span> / <%= pollQs.length %>
                    </div>
                    <div class="quiz-score-badge">
                        <i class="fas fa-users"></i>
                        <span id="pollParticipants">0 participant</span>
                    </div>
                </div>

                <div class="quiz-progress-wrap">
                    <div class="quiz-steps">
                        <% pollQs.forEach(function(q, i) { %>
                        <span class="quiz-step<%= i === 0 ? ' active' : '' %>"></span>
                        <% }); %>
                    </div>
                    <div class="quiz-progress-bar">
                        <div id="quizProgress" class="quiz-progress-fill" style="width: <%= 100 / pollQs.length %>%;"></div>
                    </div>
                </div>

                <div id="quizContent">
                    <div class="quiz-question-wrap">
                        <span class="poll-theme" id="pollTheme"></span>
                        <h3 class="quiz-question-text" id="questionText"></h3>
                    </div>

                    <div class="quiz-options" id="quizOptions"></div>
                    <p class="poll-hint" id="pollHint">Choisissez la réponse qui correspond le mieux à votre avis.</p>
                    <div class="poll-error" id="pollError" role="alert" hidden></div>

                    <div class="quiz-navigation">
                        <button id="prevBtn" class="quiz-btn-secondary" onclick="previousQuestion()" disabled>
                            <i class="fas fa-arrow-left"></i> Précédent
                        </button>
                        <button id="nextBtn" class="quiz-btn-primary" onclick="nextQuestion()">
                            Passer <i class="fas fa-arrow-right"></i>
                        </button>
                    </div>
                </div>

                <div id="quizResults" style="display:none;">
                    <div class="quiz-results-wrap">
                        <div class="quiz-result-icon"><i class="fas fa-check-circle"></i></div>
                        <h3 class="quiz-result-title">Merci pour votre participation !</h3>
                        <p class="quiz-result-message">
                            Vos réponses sont enregistrées de façon anonyme.<br>
                            De nouvelles questions sont publiées chaque jour.
                        </p>
                        <button class="quiz-btn-primary mt-2" onclick="reviewPoll()">
                            <i class="fas fa-chart-bar me-2"></i> Revoir les résultats
                        </button>
                    </div>
                </div>

                <p class="poll-disclaimer">
                    <i class="fas fa-info-circle me-1"></i>
                    Sondage en ligne ouvert à tous : les résultats reflètent l'avis des participants et ne sont pas
                    représentatifs de l'ensemble de la population. Un seul vote par question.
                </p>

            </div><!-- /.quiz-card -->
        </div>
    </section>
    <script>
        const opinionQuestions = <%- JSON.stringify(pollQs).replace(/</g, '\\u003c') %>;
    </script>
    <% } %>

    <!-- ===== RÉFLEXIONS PUBLIÉES ===== -->
<section id="reflexions" style="background: #f8f9fa; padding: 3rem 0;">
    <!-- Bannière analyses -->
    <div class="container mb-4">
        <div class="rx-banner rx-banner--analyse">
            <div class="rx-banner-icon" aria-hidden="true"><i class="fas fa-search"></i></div>
            <div class="rx-banner-body">
                <div class="rx-tag"><span class="rx-tag-main">Analyse</span><span class="rx-tag-sub">pour comprendre</span></div>
                <p class="rx-banner-text">
                    Prendre du recul, examiner une idée sous plusieurs angles, confronter les points de vue :
                    l'analyse aide à comprendre avant de juger, et à en tirer un sens pour la vie de tous les jours.
                </p>
                <p class="rx-banner-quote">« Comprendre, c'est déjà commencer à agir. »</p>
            </div>
        </div>
    </div>

    <div class="container">
        <!-- Section header style TopChrétien -->
        <div class="baume-section-header">
            <div class="baume-section-title-wrap">
                <div class="baume-section-accent"></div>
                <span class="baume-section-label"><i class="fas fa-book-open me-1"></i> Approfondir</span>
                <h2 class="baume-section-title">Analyses</h2>
                <span class="baume-section-subtitle">Des textes pour prendre du recul, comprendre et donner du sens au quotidien</span>
            </div>
        </div>
        <!-- ===== CARROUSEL DE RÉFLEXIONS ===== -->
        <div class="reflexions-carousel-container" style="display: flex; justify-content: center; align-items: center; width: 100%;">
            <!-- Indicateurs de position masqués -->
            <!-- <div class="reflexion-indicators" style="position: absolute; bottom: -40px; left: 50%; transform: translateX(-50%); display: flex; gap: 8px; z-index: 2;">
                <span class="position-text" style="background: var(--baume-accent); color: white; padding: 4px 12px; border-radius: 20px; font-size: 0.85rem; font-weight: 600;">
                    Utilisez les flèches ou la molette
                </span>
            </div> -->

            <!-- Conteneur du carrousel centré -->
            <div class="carousel-wrapper" style="overflow: hidden; border-radius: 16px; width: 100%; max-width: 1400px; margin: 0 auto; position: relative; z-index: 1; background: transparent; padding: 10px 0; display: flex; flex-direction: column; align-items: center; justify-content: center;">
                <div id="reflexionsCarousel" class="carousel-track" style="display: flex; flex-wrap: nowrap; padding: 0 15px;">
                    <!-- Le contenu sera chargé par JavaScript avec pagination -->
                </div>
            </div>
        </div>

        <!-- Bouton Voir Plus en haut de l'image -->
        <div class="text-center mb-1">
                    </div>

        <!-- Bannière point de vue -->
        <div class="rx-banner rx-banner--pdv mt-4">
            <div class="rx-banner-icon" aria-hidden="true"><i class="fas fa-comment-dots"></i></div>
            <div class="rx-banner-body">
                <div class="rx-tag"><span class="rx-tag-main">Point de vue</span><span class="rx-tag-sub">des jeunes</span></div>
                <p class="rx-banner-text">
                    Votre expérience peut éclairer quelqu'un aujourd'hui. Partagez votre avis ou votre vécu
                    sur un sujet qui vous tient à cœur : chaque point de vue compte.
                </p>
                <a href="#temoignage-form" class="rx-banner-btn"><i class="fas fa-pen"></i> Donner mon point de vue</a>
            </div>
        </div>
    </div>
</section>

    <!-- ===== FORMULAIRE DE TÉMOIGNAGE ===== -->
    <section style="background: white; padding: 3rem 0;" id="temoignage-section">
        <div class="container">

            <!-- Section header -->
            <div class="baume-section-header">
                <div class="baume-section-title-wrap">
                    <div class="baume-section-accent"></div>
                    <span class="baume-section-label"><i class="fas fa-comment-dots me-1"></i> Parole aux jeunes</span>
                    <h2 class="baume-section-title">Votre Point de Vue</h2>
                    <span class="baume-section-subtitle">Partagez votre réflexion ou votre expérience sur un sujet qui vous tient à cœur</span>
                </div>
            </div>

            <div class="pdv-form-card" id="temoignage-form">
                <aside class="pdv-form-aside">
                    <h3 class="pdv-form-aside-title">Comment ça marche</h3>
                    <ol class="pdv-steps">
                        <li>
                            <span class="pdv-step-num">1</span>
                            <div><strong>Vous écrivez</strong><p>Votre avis, votre expérience ou une idée, sur le sujet de votre choix.</p></div>
                        </li>
                        <li>
                            <span class="pdv-step-num">2</span>
                            <div><strong>Notre équipe relit</strong><p>Nous vérifions que le texte respecte chacun avant de le publier.</p></div>
                        </li>
                        <li>
                            <span class="pdv-step-num">3</span>
                            <div><strong>La communauté réagit</strong><p>Votre point de vue apparaît sur la page et chacun peut le commenter.</p></div>
                        </li>
                    </ol>
                    <p class="pdv-form-rule"><i class="fas fa-shield-alt"></i> Les propos injurieux, discriminatoires ou publicitaires ne sont pas publiés.</p>
                </aside>

                <form class="pdv-form" action="/reflexion/point-de-vue" method="POST" novalidate>
                    <h3 class="pdv-form-title">Rédiger votre point de vue</h3>
                    <div id="temoignageMessageAlert" class="pdv-form-msg" role="status" hidden></div>

                    <div class="pdv-form-grid">
                        <div class="pdv-field">
                            <label for="nom">Nom ou pseudonyme</label>
                            <input type="text" class="pdv-input" id="nom" name="nom" maxlength="60" required placeholder="Ex : Hery">
                            <small>Affiché avec votre point de vue.</small>
                        </div>
                        <div class="pdv-field">
                            <label for="email">Adresse e-mail</label>
                            <input type="email" class="pdv-input" id="email" name="email" required placeholder="Ex : hery@exemple.com">
                            <small>Jamais publiée, sert uniquement à vous contacter si besoin.</small>
                        </div>
                    </div>

                    <div class="pdv-field">
                        <label for="ville">Ville <span class="pdv-optional">facultatif</span></label>
                        <input type="text" class="pdv-input" id="ville" name="ville" maxlength="60" placeholder="Ex : Antananarivo">
                    </div>

                    <div class="pdv-field">
                        <div class="pdv-label-row">
                            <label for="temoignage">Votre point de vue</label>
                            <span class="pdv-counter"><span id="temoignageCharCount">0</span> · minimum 10 caractères</span>
                        </div>
                        <textarea class="pdv-input" id="temoignage" name="temoignage" rows="6" required placeholder="Donnez votre avis, racontez votre expérience, proposez une idée…"></textarea>
                    </div>

                    <label class="pdv-consent" for="consentement">
                        <input type="checkbox" id="consentement" name="consentement" required>
                        <span>J'accepte que mon point de vue soit publié sur le site et visible par tous, après relecture par l'équipe Telex.</span>
                    </label>

                    <div class="pdv-form-footer">
                        <small><i class="fas fa-lock"></i> Votre adresse e-mail reste privée.</small>
                        <button type="submit" class="pdv-form-submit" id="temoignageSubmitBtn">
                            <i class="fas fa-paper-plane"></i> Publier mon point de vue
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </section>

    <!-- ===== TÉMOIGNAGES APPROUVÉS ===== -->
    <section class="py-4" style="background-color: white; position: relative;">
        <div class="container-fluid px-0">
            <!-- Bannière points de vue publiés -->
            <div class="container">
                <div class="rx-banner rx-banner--list">
                    <div class="rx-banner-icon" aria-hidden="true"><i class="fas fa-users"></i></div>
                    <div class="rx-banner-body">
                        <div class="rx-tag"><span class="rx-tag-main">Ils ont pris la parole</span></div>
                        <p class="rx-banner-text">Les points de vue partagés par la communauté Telex, relus par notre équipe avant publication.</p>
                    </div>
                </div>
            </div>
        
        <div class="container" style="margin-top: 30px;">
            <div class="section-header">
                <div class="section-title-wrapper" style="text-align: center;">
                </div>
            </div>
            
            <div id="temoignages-container" class="row align-items-start">
                <!-- Les témoignages seront chargés dynamiquement avec le nouveau style -->
                <div class="col-12 text-center">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Chargement...</span>
                    </div>
                    <p class="mt-3 text-muted">Chargement des points de vue...</p>
                </div>
            </div>
            
            <div class="text-center mt-4">
                <button class="btn btn-outline-secondary" onclick="loadMoreTemoignages()" style="border-color: var(--baume-primary); color: var(--baume-primary); box-shadow: 0 2px 8px rgba(46, 92, 78, 0.2);">
